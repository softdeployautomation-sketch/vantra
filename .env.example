# Vantra environment configuration.
# Copy to .env and fill in real values. NEVER commit .env (it holds live secrets).

# TacticalRMM API (server-side, least-privilege "vantra-service" key)
# Task 59 (Task 53 Part 1): dual agent domains — public (agent.broks.beauty)
# vs private (api.instaweb.top), resolved per-org by agentDomainTier (Task 61).
# TRMM_API_BASE_URL is legacy, kept only until Task 61 swaps its readers over.
TRMM_PUBLIC_API_BASE_URL=https://agent.broks.beauty
TRMM_PRIVATE_API_BASE_URL=https://api.instaweb.top
TRMM_API_BASE_URL=https://api.instaweb.top
TRMM_API_KEY=

# PostgreSQL (own DB on the VPS, zero shared tables with TRMM's Django DB)
DATABASE_URL=postgresql://vantra_app:***@127.0.0.1:5432/vantra

# Session signing secret (32+ random bytes, base64)
SESSION_SECRET=

# Resend email provider
# For a local build without a real key, use: re_local_dev_placeholder
# (email sending is stubbed/disabled in that case).
RESEND_API_KEY=
EMAIL_FROM=noreply@instaweb.top
# Public HTTPS origin for the app. MUST be a real, reachable public https:// URL
# (NEVER http://localhost) — for device unlock the on-device credential prompt
# POSTs the PIN over HTTPS to <origin>/api/device-callback/credential. lib/credential-callback.ts
# rewrites http→https, rejects loopback/bare-http/missing values fail-closed before anyone
# launches a prompt, so this must be the real production origin, e.g.: https://vantra.instaweb.top
APP_BASE_URL=https://vantra.instaweb.top

# Business rules
DEPLOYMENT_EXPIRY_HOURS=72
MAX_DEVICES_FREE_TIER=3
# Premium-tier active-installer cap (only used once a user is premium).
MAX_DEVICES_PREMIUM_TIER=25

# OpenNode (Bitcoin billing) — deprecated and left blank; removed from the app.
# OPENNODE_API_KEY=
# OPENNODE_API_BASE_URL=https://api.opennode.com/v1

# Admin panel shared passcode (Channelry-style). Fails CLOSED when unset — the
# /admin panel is locked (never open) until this is set.
ADMIN_TOKEN=

# Email address for internal ops alerts (e.g. "payment awaiting review"). Optional —
# when unset, only the Telegram alert is sent for payment reviews.
ADMIN_ALERT_EMAIL=

# Internal cron callbacks (POST /api/internal/*). Sent as
# `Authorization: Bearer <INTERNAL_CRON_SECRET>` by systemd timers. Fails CLOSED
# when unset — the internal routes return 401.
INTERNAL_CRON_SECRET=

# Telegram notification bot — all OPTIONAL (notifications silently disable if
# unset). Bot username has no "@" prefix.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Numeric chat ID of the operator's own chat — where admin/ops alerts land.
ADMIN_TELEGRAM_CHAT_ID=

# Task 25 — 32 random bytes (base64) used to encrypt stored device credentials
# at rest (AES-256-GCM). Fail-closed: credential store/read routes refuse to run
# while unset. Generate once with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Task 44.2 — Vantra EXE license signing secret. Its own env var (never reuse
# SESSION_SECRET or any other secret). Fail-closed: validating/issuing an EXE
# license throws while unset. Generate once with: openssl rand -base64 48
# NOTE: never set VANTRA_LOCAL_EXE here — that belongs only in the Tauri-bundled
# desktop EXE's own local .env, never on the production VPS.
EXE_LICENSE_SECRET=

# Local-desktop EXE runtime flag. MUST stay empty/unset in the deployed web
# server's .env: only the desktop EXE's bundled local runtime sets this to "true".
# When it is not "true", /api/exe-license/* fail closed with 404.
VANTRA_LOCAL_EXE=

# Server port
PORT=3300