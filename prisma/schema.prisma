// Vantra Prisma schema — own Postgres DB, zero shared tables with TRMM's Django DB.
// Targets PostgreSQL (see decision #6: don't change DB from Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  emailVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
  isStaff      Boolean  @default(false) // gates Technician Console; set manually via direct SQL
  notifyDeviceOffline Boolean  @default(true) // Settings → Notifications
  notifyDeviceOnline  Boolean  @default(true) // Settings → Notifications — independent of notifyDeviceOffline
  notifyTicketReply  Boolean  @default(true)
  telegramChatId     String?  @unique // the customer's Telegram chat — set via the /start deep-link flow
  telegramLinkToken  String?  @unique // one-time 15-min link token; cleared after a successful link
  telegramLinkTokenExpiresAt DateTime? // expiry for telegramLinkToken — older links are rejected
  verifications      VerificationCode[]
  tickets            Ticket[]
  ticketMessages     TicketMessage[]
  payments           Payment[]
  // Multi-org (MSP/reseller): a user owns several separate organizations, each
  // with its own TRMM client/site/plan. activeOrgId drives the org switcher's
  // default and every org-scoped route below.
  activeOrgId    String?
  organizations  Organization[]
  // Wallet top-up balance (in US cents), SHARED across all the user's orgs.
  // Premium is still per-organization — Activate/Renew deduct from this balance.
  walletBalanceCents Int @default(0)
  notificationLogs   NotificationLog[]
  technicianSessionLogs TechnicianSessionLog[]
  queuedCommands      QueuedAgentCommand[]
  deviceCredentialRequests DeviceCredentialRequest[]
  deviceCredentials   DeviceCredential[]
  deviceCredentialAuditLogs DeviceCredentialAuditLog[]
}

// One login can manage several separate organizations (MSP/reseller), each with
// its own TRMM client/site/device list and its own premium subscription. The
// wallet balance stays shared on User (not modeled here — a separate follow-up
// task spends against Organization.plan/premiumExpiresAt).
model Organization {
  id               String    @id @default(cuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id])
  name             String    // customer-chosen, shown in the org switcher — replaces User.orgName
  trmmClientId     Int?
  trmmSiteId       Int?
  plan             String    @default("free") // "free" | "premium" — plain scalar (matches isStaff/Ticket.status convention)
  premiumExpiresAt DateTime? // null while free; set/extended by each successful charge
  createdAt        DateTime  @default(now())
  deployments      Deployment[]
  scripts          Script[]
  deviceGroups     DeviceGroup[]
  technicianSessionLogs TechnicianSessionLog[]
  deviceLabels     DeviceLabel[]
  deviceCredentialRequests DeviceCredentialRequest[]
  deviceCredentials DeviceCredential[]
  deviceCredentialAuditLogs DeviceCredentialAuditLog[]

  @@index([ownerId])
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
}

model Deployment {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  // Nullable now — the "separated" installMethod has no TRMM Deployment object.
  trmmDeploymentUid String?  @unique
  installMethod     String   @default("merged") // "merged" | "separated" | "msi" | "zip"
  trmmSiteId        Int?     // the per-device TRMM Site created for this install
  deviceName        String?  // customer-chosen device name
  msiReady          Boolean  @default(false) // true only when the MSI generator call succeeded
  vbsUrl            String?  // generator's VBS launcher URL — premium only, null otherwise
  exeUrl            String?  // generator's branded EXE URL — premium + ico uploaded only
  zipUrl            String?  // STAGE 2 masked zip download link (installMethod = "zip")
  monType           String
  goarch            String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([organizationId, expiresAt])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  ip        String
  kind      String
  createdAt DateTime @default(now())

  @@index([ip, kind, createdAt])
}

// User-written scripts (customer-facing Script Manager). Customer-facing display
// `name` is stored here ONLY; the TRMM-side name is `"{name} [vantra:{cuid}]"`
// (unique-by-construction) since TRMM's Script.name has no uniqueness/tenant scoping.
model Script {
  id           String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  trmmScriptId Int      @unique // TRMM's own id — the only handle back to it
  name         String // customer-facing display name, never derived from TRMM's (suffixed) name
  shell        String
  description  String?
  createdAt    DateTime @default(now())

  @@index([organizationId])
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  subject   String
  status    String         @default("open") // "open" | "in_progress" | "resolved"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TicketMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  amountUsd         Int      // CLAIMED wallet top-up amount in whole dollars (free-entry, validated 1–5000)
  kind              String   @default("topup") // "topup" going forward (was "initial" | "renewal" historically — leave old rows alone)
  status            String   @default("pending") // "pending" | "paid" | "underpaid" | "expired" | "refunded" | "rejected"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Manual crypto payments (BTC + USDT-TRC20). OpenNode is decommissioned — no
  // new rows use any other method, and historical "opennode" rows are inert.
  method               String // "btc" | "usdt_trc20" | "usdt_erc20"
  walletAddress        String?  // admin-configured address snapshotted at order-creation time
  priceAtOrderUsd      Float?   // BTC/USD or USDT/USD rate used to quote expectedAmountCrypto
  expectedAmountCrypto Float?   // amountUsd / priceAtOrderUsd, frozen at order creation
  txHash               String?  @unique // customer-submitted; unique DB-wide blocks reusing a hash across orders
  actualAmountUsd      Float?   // on-chain amount * priceAtOrderUsd (order-time price, not a fresh one)
  confirmations        Int?
  verificationStatus   String   @default("pending") // "pending"|"pending_review"|"auto_approved"|"manually_approved"|"manually_rejected"|"flagged"|"rejected"
  reviewedAt           DateTime?
  reviewNote           String?
  verificationAttempts PaymentVerificationAttempt[]

  @@index([userId, status])
  @@index([method, verificationStatus])
}

model NotificationLog {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  eventType    String    // "payment_pending" | "payment_confirmed" | "payment_rejected" | "admin_alert" | ...
  channel      String    // "email" | "telegram"
  recipient    String // the email address or chat id actually targeted, for audit
  outcome      String    @default("sent") // "sent" | "failed"
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model PaymentVerificationAttempt {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id])
  txHash     String
  outcome    String   // "confirmed_present" | "flagged" | "rejected" | "not_found" | "not_confirmed" | "wrong_contract" | "address_mismatch" | "fetch_error"
  resultJson String   // JSON.stringify(CryptoVerifyResult) — full audit trail
  createdAt  DateTime @default(now())

  @@index([paymentId, createdAt])
}

model AdminSetting {
  id                String    @id @default("singleton") // always the same id — enforces a true singleton row
  btcAddress        String?
  usdtTrc20Address  String?
  // USDT-ERC20 (Ethereum) — a second USDT wallet so buyers on Ethereum-native
  // exchanges (which often don't support Tron withdrawals) can pay directly.
  // Independent from usdtTrc20Address — both can be configured at once.
  usdtErc20Address  String?
  lastLowMemAlertAt DateTime? // debounce — don't re-alert every poll while memory stays high
  updatedAt         DateTime  @updatedAt
  // Premium pricing (in US cents), admin-adjustable at runtime — was hardcoded
  // as ACTIVATE_PREMIUM_CENTS/RENEW_PREMIUM_CENTS in the activate/renew-premium
  // routes. Defaults match that old hardcoded behavior exactly ($100 / $20).
  activatePremiumCents Int @default(10000) // first activation — 30 days included
  renewPremiumCents    Int @default(2000)  // renewal — extends 30 more days
}

model TicketMessage {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  authorUserId  String
  author        User     @relation(fields: [authorUserId], references: [id])
  authorIsStaff Boolean // snapshot at send time, survives later isStaff changes
  body          String
  createdAt     DateTime @default(now())

  @@index([ticketId, createdAt])
}

// Customer-created device groupings. Groups are scoped by organizationId (each org's
// groups are its own). Membership references TRMM agent_id strings — opaque,
// NOT local foreign keys (devices only ever live in TRMM, never Vantra's DB).
model DeviceGroup {
  id        String   @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name      String
  createdAt DateTime @default(now())
  members   DeviceGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model DeviceGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  group     DeviceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agentId   String      // TRMM agent_id — opaque string, NOT a local foreign key
  userId    String      // denormalized owner, checked independently on every read/write — defense in depth
  createdAt DateTime    @default(now())

  @@unique([groupId, agentId])
  @@index([userId, agentId])
}

// Tracks last-seen agent status per user, purely so the offline/online poller
// can detect a TRANSITION (not just current state) without re-notifying every
// cycle while a device stays offline. Keyed by TRMM agent_id (opaque string,
// same "no local FK to TRMM" posture as DeviceGroupMember in the device-groups task).
model DeviceStatusSnapshot {
  id         String   @id @default(cuid())
  userId     String
  agentId    String
  lastStatus String   // "online" | "offline" | "overdue"
  updatedAt  DateTime @updatedAt

  @@unique([userId, agentId])
}

// A command the user queued against a device that was offline at the time,
// intended to fire automatically the next time the device comes online (see
// Task 18 — "queue and time it for when it comes online", triggered by the
// online transition, not a calendar-time scheduler). Created by
// POST /api/devices/[agentId]/queue-command; fired by the
// telegram-device-check poller (the already-running ~5-min timer — no new
// cron) through the same sendRawCmd call the live cmd route uses. Keyed by
// TRMM agent_id (opaque string, no local FK — same NLR posture as
// DeviceGroupMember/DeviceStatusSnapshot); ownership is enforced via userId +
// the agent's owning org on every read/write.
model QueuedAgentCommand {
  id             String   @id @default(cuid())
  agentId        String   // TRMM agent_id — opaque string, NOT a local foreign key
  userId         String   // denormalized owner, checked independently on every read/write — defense in depth
  user           User     @relation(fields: [userId], references: [id])
  shell          String   // "cmd" | "powershell"
  cmd            String
  timeoutSeconds Int
  runAsUser      Boolean  @default(false)
  status         String   @default("queued") // "queued" | "sent" | "failed" | "cancelled"
  createdAt      DateTime @default(now())
  sentAt         DateTime?
  error          String?

  @@index([agentId, status])
}

// Audit trail for the Private Technician Session feature (see
// PLAN_PRIVATE_TECHNICIAN_SESSION.md). Every Prepare/Blank/Restore/Release
// action gets a row — this is the accountability control that makes
// "staff can work invisibly on a customer's device" defensible: there must
// always be a clear record of what happened, when, and (for actions a human
// didn't directly click) why. Never throws on write failure — see
// lib/technician-session-log.ts, mirrors lib/notification-log.ts's contract.
model TechnicianSessionLog {
  id             String   @id @default(cuid())
  agentId        String   // TRMM agent_id — opaque string, no local FK (same posture as DeviceGroupMember)
  organizationId String?  // the target device's owning org, if resolved at the time
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?  // the staff member who triggered this, null when system-triggered
  actorUser      User?    @relation(fields: [actorUserId], references: [id])
  actorKind      String   // "staff" | "auto_prepare_on_device_add" | "watchdog_timeout"
  action         String   // "prepare" | "blank" | "restore" | "release"
  outcome        String   @default("ok") // "ok" | "failed"
  detail         String?  // free-text context (e.g. an error message, or "device added" for auto-prepare)
  createdAt      DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([organizationId, createdAt])
}

// Durable audit of API-route failures (the admin "Errors" tab). One row per
// catch block that previously only did console.error — every failed attempt
// must be diagnosable in the admin panel, never silent. Mirrors
// lib/notification-log.ts's contract: logging must never break the request,
// so logApiError wraps its own write in try/catch (see lib/api-error-log.ts).
model ApiErrorLog {
  id           String   @id @default(cuid())
  route        String   // route pattern, e.g. "/api/devices/[agentId]/mesh"
  method       String   // "GET" | "POST" | "DELETE" | "PATCH" | "PUT"
  statusCode   Int      // the status returned to the client (or closest equivalent)
  errorMessage String   // the REAL error (err.message / String(err)), never a placeholder
  stack        String?  // err.stack when available
  userId       String?  // who was making the request, if known
  // True when the overall request still returned a 2xx to the client despite
  // this logged failure (a "log-and-continue" case — e.g. a confirmation
  // email failed but the payment itself was still confirmed). Defaults false
  // (the normal "the request itself failed" case) so every pre-existing call
  // site keeps its current meaning unless explicitly marked otherwise.
  clientReceivedSuccess Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([route, createdAt])
  @@index([createdAt])
}

// A customer-editable nickname for a device, independent of TRMM's own
// hostname/site name (which is often an unmemorable machine name or a
// leftover "Default Site"). Keyed directly by TRMM's agent_id — the one
// stable identifier every device list/detail response already carries —
// rather than trying to correlate through Deployment.trmmSiteId, which would
// need a numeric site id TRMM's agent-list response doesn't expose. Settable
// at any time, not just at Add Device time.
model DeviceLabel {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentId        String   // TRMM agent_id — opaque string, no local FK (same posture as DeviceGroupMember)
  label          String
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, agentId])
}

// Task 25 — staff-only, device-scoped credential request for a managed Windows
// device. On request, the Windows agent shows a neutral "Windows Security /
// Device locked" prompt; the person at the device enters the numeric PIN; the
// PIN travels back to the backend over HTTPS and is stored ENCRYPTED at rest in
// DeviceCredential (never in this table). This table tracks only the request
// lifecycle + a one-time callback token — it never holds the credential.
//
// Device-scoped by TRMM agent_id (opaque string, no local FK — same posture as
// QueuedAgentCommand / DeviceLabel / TechnicianSessionLog). `platform` keeps the
// model device-scoped without being inherently Windows-only (macOS is addable
// later without a redesign), though only Windows is implemented this task.
model DeviceCredentialRequest {
  id             String   @id @default(cuid())
  agentId        String
  platform       String   @default("windows")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // The staff member who requested — null when system/cron-triggered.
  actorUserId    String?
  actorUser      User?    @relation(fields: [actorUserId], references: [id])
  pinLength      Int      // 4 | 6 | 8 — the numeric PIN length this device uses
  status         String   @default("requested")
  // "requested" | "waiting_for_user" | "credential_received" | "stored"
  // | "pending_next_boot" | "waiting_20_minutes" | "completed"
  // | "cancelled" | "expired" | "device_offline" | "failed"
  // Task 27 — schedule type. "immediate" fires the prompt right away (Task 25/26);
  // "next_boot" is the scheduled, one-time flow: pending_next_boot while the
  // device is offline, then a bootDelayMinutes countdown (waiting_20_minutes)
  // that starts only once the device comes online (or immediately, if the device
  // was already online when staff scheduled it).
  schedule         String   @default("immediate")
  // Task 27 — length of the countdown once the "timer started" (minutes). Default 20.
  bootDelayMinutes Int      @default(20)
  // Task 27 — the server-side timestamp that started the countdown (set when the
  // request leaves pending_next_boot for waiting_20_minutes, or at schedule time
  // when the device was already online). null while still pending next boot. The
  // countdown is DB-backed; there is NO browser timer anywhere.
  timerStartedAt   DateTime?
  // SHA-256 hex of the one-time callback token (plaintext token is NEVER stored —
  // a DB leak must not expose live callback tokens). Nulled once consumed.
  tokenHash      String?  @unique
  tokenExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agentId, status])
  @@index([organizationId, createdAt])
}

// The stored, encrypted credential for ONE managed device (Task 25). One row
// per agentId (each device has a single current credential; a newer successful
// request replaces it). `encryptedValue` is base64(nonce12 || tag16 || ct) from
// AES-256-GCM — never plaintext, never logged, never returned through normal
// status APIs. Only the audited, staff+device-gated reveal endpoint decrypts it.
// `platform` mirrors DeviceCredentialRequest so the model is not Windows-only.
model DeviceCredential {
  id             String   @id @default(cuid())
  agentId        String   @unique // one current credential per device
  platform       String   @default("windows")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  username       String?  // reserved for a future capture of the account name (not collected in this pass)
  pinLength      Int      // 4 | 6 | 8
  encryptedValue String   // AES-256-GCM ciphertext
  requestId      String?  // the DeviceCredentialRequest that produced this row
  requestedByUserId String?
  requestedByUser    User?  @relation(fields: [requestedByUserId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Audit trail for credential-related actions (Task 25). Records who/what/when/
// result WITHOUT ever recording the credential itself — the PIN/plaintext is
// structurally absent from this table. Never throws on write failure (mirrors
// lib/technician-session-log.ts / lib/notification-log.ts's contract).
model DeviceCredentialAuditLog {
  id             String   @id @default(cuid())
  agentId        String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?  // the staff member who acted
  actorUser      User?    @relation(fields: [actorUserId], references: [id])
  requestId      String?  // the DeviceCredentialRequest id, when one exists
  action         String   // "DEVICE_CREDENTIAL_REQUESTED" | "DEVICE_CREDENTIAL_STORED" | "DEVICE_CREDENTIAL_RETRIEVED"
  outcome        String   @default("ok") // "ok" | "failed"
  detail         String?  // free-text context (e.g. an error message) — MUST never contain a credential
  createdAt      DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([organizationId, createdAt])
}